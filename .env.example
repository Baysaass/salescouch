# ── Нэвтрэлт (Auth.js) ───────────────────────────────
# `npx auth secret` эсвэл `openssl rand -base64 32`
AUTH_SECRET=

# Google OAuth (Gmail-ээр нэвтрэх) — console.cloud.google.com → Credentials → OAuth client ID (Web)
# Authorized redirect URI:
#   http://localhost:3100/api/auth/callback/google
#   https://<таны-домэйн>.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Локал туршилтын нэвтрэлт (Google тохируулаагүй үед dev горимд автоматаар асна)
# AUTH_DEV_LOGIN=true

# ── Өгөгдлийн сан ───────────────────────────────────
# Хоосон бол ./data/pglite дотор локал Postgres (PGlite) ашиглана.
# Vercel дээр Supabase → Project Settings → Database → Connection string (Transaction pooler, 6543):
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ── OpenAI ──────────────────────────────────────────
# Хоосон бол локал (загварт суурилсан) коуч ажиллана.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
